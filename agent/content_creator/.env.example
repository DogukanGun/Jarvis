# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=content-creator

# Kafka Topics
KAFKA_TOPIC_REQUESTS=media.render.requests
KAFKA_TOPIC_VIDEO_REQUESTS=media.render.video.requests
KAFKA_TOPIC_IMAGE_PROMPT_REQUESTS=media.render.image.prompt.requests
KAFKA_TOPIC_IMAGE_REFERENCE_REQUESTS=media.render.image.reference.requests
KAFKA_TOPIC_IMAGE_EDIT_REQUESTS=media.render.image.edit.requests
KAFKA_TOPIC_RESULTS=media.render.results

# MinIO/S3 Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=media-renders
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000

# Model Configuration
MODEL_CACHE_DIR=/models
QWEN_IMAGE_MODEL=Qwen/Qwen-Image-2512
QWEN_IMAGE_EDIT_MODEL=Qwen/Qwen-Image-Edit-2511
LTX_VIDEO_MODEL=Lightricks/LTX-2

# LTX-2 Model Paths (optional - auto-downloaded if not specified)
# Set these if you have pre-downloaded models locally
# LTX_CHECKPOINT_PATH=/models/ltx-2-19b-dev-fp8.safetensors
# LTX_DISTILLED_LORA_PATH=/models/ltx-2-19b-distilled-lora-384.safetensors
# LTX_SPATIAL_UPSAMPLER_PATH=/models/ltx-2-spatial-upscaler-x2-1.0.safetensors
# LTX_GEMMA_ROOT=/models/gemma-3-12b-it-qat-q4_0-unquantized
LTX_DISTILLED_LORA_STRENGTH=0.6
LTX_ENABLE_FP8=true

# LTX-2 Generation Defaults (optimized for two-stage pipeline)
LTX_DEFAULT_HEIGHT=1024
LTX_DEFAULT_WIDTH=1536
LTX_DEFAULT_NUM_FRAMES=121
LTX_DEFAULT_FRAME_RATE=24.0
LTX_DEFAULT_CFG_GUIDANCE_SCALE=4.0
LTX_DEFAULT_NUM_INFERENCE_STEPS=40

# Generation Defaults (for image generation)
DEFAULT_IMAGE_WIDTH=1024
DEFAULT_IMAGE_HEIGHT=1024
DEFAULT_VIDEO_WIDTH=768
DEFAULT_VIDEO_HEIGHT=512
DEFAULT_VIDEO_DURATION=6.0
DEFAULT_VIDEO_FPS=24
DEFAULT_GUIDANCE_SCALE=7.5
DEFAULT_NUM_INFERENCE_STEPS=50

# Worker Configuration
WORKER_TYPE=router
GPU_DEVICE=cuda:0

# HTTP Client
HTTP_TIMEOUT=30
