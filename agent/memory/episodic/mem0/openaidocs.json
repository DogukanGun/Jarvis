  "components": {
    "schemas": {
      "AddMemoryRequest": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text",
            "description": "Memory text content"
          },
          "user_id": {
            "type": "string",
            "title": "User Id",
            "description": "User identifier"
          },
          "metadata": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Metadata",
            "description": "Optional metadata"
          }
        },
        "type": "object",
        "required": [
          "text",
          "user_id"
        ],
        "title": "AddMemoryRequest",
        "example": {
          "metadata": {
            "category": "hobbies"
          },
          "text": "I love playing basketball on weekends",
          "user_id": "user123"
        }
      },
      "AddMessagesRequest": {
        "properties": {
          "messages": {
            "items": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "type": "array",
            "title": "Messages",
            "description": "Conversation messages"
          },
          "user_id": {
            "type": "string",
            "title": "User Id",
            "description": "User identifier"
          },
          "metadata": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Metadata",
            "description": "Optional metadata"
          }
        },
        "type": "object",
        "required": [
          "messages",
          "user_id"
        ],
        "title": "AddMessagesRequest",
        "example": {
          "messages": [
            {
              "content": "Hi, I'm Alex. I love basketball.",
              "role": "user"
            },
            {
              "content": "Nice to meet you Alex!",
              "role": "assistant"
            }
          ],
          "user_id": "user123"
        }
      },
      "DeleteMemoryRequest": {
        "properties": {
          "memory_id": {
            "type": "string",
            "title": "Memory Id",
            "description": "Memory ID to delete"
          }
        },
        "type": "object",
        "required": [
          "memory_id"
        ],
        "title": "DeleteMemoryRequest"
      },
      "GetAllMemoriesRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id",
            "description": "User identifier"
          }
        },
        "type": "object",
        "required": [
          "user_id"
        ],
        "title": "GetAllMemoriesRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MemoryResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "data": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "success",
          "message"
        ],
        "title": "MemoryResponse"
      },
      "SearchMemoryRequest": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query",
            "description": "Search query"
          },
          "user_id": {
            "type": "string",
            "title": "User Id",
            "description": "User identifier"
          },
          "limit": {
            "type": "integer",
            "maximum": 100,
            "minimum": 1,
            "title": "Limit",
            "description": "Maximum number of results",
            "default": 5
          }
        },
        "type": "object",
        "required": [
          "query",
          "user_id"
        ],
        "title": "SearchMemoryRequest",
        "example": {
          "limit": 5,
          "query": "What are my hobbies?",
          "user_id": "user123"
        }
      },
      "UpdateMemoryRequest": {
        "properties": {
          "memory_id": {
            "type": "string",
            "title": "Memory Id",
            "description": "Memory ID to update"
          },
          "text": {
            "type": "string",
            "title": "Text",
            "description": "New memory text"
          }
        },
        "type": "object",
        "required": [
          "memory_id",
          "text"
        ],
        "title": "UpdateMemoryRequest",
        "example": {
          "memory_id": "mem_123abc",
          "text": "I love playing basketball and tennis on weekends"
        }
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}