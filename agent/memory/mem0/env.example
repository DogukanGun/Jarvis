# Mem0 Self-Hosted Configuration
# Copy this file to .env and update the values

# ============================================
# Neo4j Configuration
# ============================================
NEO4J_URL=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=mem0password

# ============================================
# Qdrant Configuration
# ============================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=memory_store

# ============================================
# Ollama Configuration
# ============================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# ============================================
# Mem0 Settings
# ============================================
# Embedding dimensions (768 for nomic-embed-text)
EMBEDDING_MODEL_DIMS=768

# LLM temperature (0 = deterministic, 1 = creative)
LLM_TEMPERATURE=0

# Maximum tokens for LLM responses
LLM_MAX_TOKENS=2000

# ============================================
# Application Settings
# ============================================
# Default user ID for testing
DEFAULT_USER_ID=default_user

# Enable debug logging
DEBUG=false

# ============================================
# API Server Settings
# ============================================
# API server host (0.0.0.0 for external access)
API_HOST=0.0.0.0

# API server port
API_PORT=8000

