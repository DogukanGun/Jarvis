{
  "name": "solana-trader",
  "version": "0.1.0",
  "description": "Jarvis Solana trading agent — Solana Agent Kit v2 wrapped behind Fastify, signing proxied to the Electron loopback signer.",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@solana-agent-kit/adapter-mcp": "^2.0.7",
    "@solana-agent-kit/plugin-defi": "^2.0.8",
    "@solana-agent-kit/plugin-token": "^2.0.9",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.5",
    "bs58": "^6.0.0",
    "fastify": "^5.1.0",
    "solana-agent-kit": "^2.0.10",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
