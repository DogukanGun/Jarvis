# LLM Configuration
# Option 1: Use Ollama (local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Option 2: Use OpenAI (if set, takes precedence over Ollama)
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini

# Tool Server API Keys
# Brave Search API (get key at https://brave.com/search/api/)
BRAVE_API_KEY=

# Perplexity API (optional, alternative to Brave)
# PERPLEXITY_API_KEY=
